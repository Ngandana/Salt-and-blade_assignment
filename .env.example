# Optional. Without these, bookings are kept in server memory (fine for a demo, resets on redeploy).
# With them, bookings persist and double-booking is blocked at database level.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Public site URL, used for metadata and the .ics file
NEXT_PUBLIC_SITE_URL=https://saltandblade.vercel.app
